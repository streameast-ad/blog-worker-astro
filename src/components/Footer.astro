---
import { SITE_CONFIG } from '../lib/config';
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 mt-20 border-t border-slate-800" role="contentinfo">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <!-- Col 1: Brand & Mission -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-blue-500 flex items-center justify-center text-white font-bold">
            ⚡
          </div>
          <span class="text-xl font-bold text-white tracking-tight">EdgeBlog</span>
        </div>
        <p class="text-sm text-slate-400 max-w-md leading-relaxed">
          {SITE_CONFIG.description}
        </p>
        <div class="flex items-center gap-2 text-xs text-slate-400">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Running globally on Cloudflare Workers & KV Edge Storage
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">Home & Articles</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors">Contact Support</a></li>
          <li><a href="/admin" class="hover:text-white transition-colors">Admin Portal</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & SEO Resources -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Legal & Feeds</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="/sitemap.xml" class="hover:text-white transition-colors">XML Sitemap</a></li>
          <li><a href="/rss.xml" class="hover:text-white transition-colors">RSS Feed (XML)</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>© {currentYear} EdgeBlog. All rights reserved. Built with Astro & Cloudflare Workers.</p>
      <div class="flex items-center gap-4">
        <a href="/privacy-policy" class="hover:underline">Privacy</a>
        <span>•</span>
        <a href="/terms" class="hover:underline">Terms</a>
        <span>•</span>
        <a href="/sitemap.xml" class="hover:underline">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
