---
import type { PostSummary } from '../lib/types';

interface Props {
  post: PostSummary;
}

const { post } = Astro.props;

// Format date nicely
const formattedDate = new Date(post.published_at).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col group">
  <!-- Featured Image -->
  {post.featured_image && (
    <a href={`/post/${post.slug}`} class="block aspect-video overflow-hidden bg-slate-100 relative" tabindex="-1">
      <img
        src={post.featured_image}
        alt={post.featured_image_alt || post.title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
      <div class="absolute top-3 left-3">
        <span class="inline-block px-2.5 py-1 text-xs font-semibold uppercase tracking-wider bg-white/90 backdrop-blur text-blue-700 rounded-md shadow-sm">
          {post.category || 'General'}
        </span>
      </div>
    </a>
  )}

  <!-- Content -->
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      {!post.featured_image && (
        <span class="inline-block px-2.5 py-1 text-xs font-semibold uppercase tracking-wider bg-blue-50 text-blue-700 rounded-md mb-3">
          {post.category || 'General'}
        </span>
      )}

      <h2 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 leading-snug">
        <a href={`/post/${post.slug}`}>
          {post.title}
        </a>
      </h2>

      <p class="mt-3 text-slate-600 text-sm line-clamp-3 leading-relaxed">
        {post.excerpt}
      </p>
    </div>

    <!-- Meta Info -->
    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <div class="flex items-center gap-2">
        <span class="font-medium text-slate-700">{post.author_name}</span>
        <span>•</span>
        <time datetime={post.published_at}>{formattedDate}</time>
      </div>
      <div class="flex items-center gap-1 font-medium text-slate-600">
        <span>⏱️</span>
        <span>{post.reading_time_minutes} min read</span>
      </div>
    </div>
  </div>
</article>
