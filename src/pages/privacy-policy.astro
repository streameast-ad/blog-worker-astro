---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_CONFIG } from '../lib/config';
import { generateWebPageSchema, generateBreadcrumbSchema } from '../lib/seo';

const pageTitle = `Privacy Policy — ${SITE_CONFIG.title}`;
const pageDescription = `Learn about how EdgeBlog collects, protects, and handles user data in compliance with GDPR, CCPA, and latest Google Search standards.`;
const lastUpdated = 'November 18, 2026';

const breadcrumbs = [
  { name: 'Privacy Policy', url: '/privacy-policy' }
];

const webPageSchema = generateWebPageSchema('Privacy Policy', pageDescription, '/privacy-policy');
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE_CONFIG.site_url}/privacy-policy`}
  schema={webPageSchema}
  breadcrumbSchema={breadcrumbSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-10 pb-6 border-b border-slate-200">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold mb-3">
        <span>🛡️ Legal & Privacy</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Privacy Policy
      </h1>
      <p class="text-sm text-slate-500 mt-2">
        Last updated on <time datetime="2026-11-18">{lastUpdated}</time>
      </p>
    </header>

    <div class="prose prose-slate max-w-none text-base sm:text-lg leading-relaxed space-y-6">
      <p>
        At <strong>EdgeBlog</strong>, accessible from <code>{SITE_CONFIG.site_url}</code>, one of our main priorities is the privacy of our visitors. This Privacy Policy document outlines the types of information that is collected and recorded by EdgeBlog and how we use it, in full accordance with modern global privacy regulations (GDPR, CCPA) and Google webmaster requirements.
      </p>

      <h2>1. Information We Collect</h2>
      <p>
        We believe in data minimization. When you browse our blog:
      </p>
      <ul>
        <li><strong>Standard Log Data:</strong> Like most websites, our Cloudflare edge servers automatically log basic non-personally identifiable technical information such as internet protocol (IP) addresses, browser type, Internet Service Provider (ISP), date/time stamps, referring/exit pages, and number of clicks to analyze trends and prevent DDoS attacks.</li>
        <li><strong>Contact Information:</strong> If you contact us directly via email or our contact page, we may receive additional information about you such as your name, email address, and the contents of your message.</li>
      </ul>

      <h2>2. Cloudflare Edge Security & Performance</h2>
      <p>
        Our website is hosted using Cloudflare Workers. Cloudflare acts as a reverse proxy to cache static assets, mitigate malicious web traffic, and ensure lightning-fast global page delivery. Cloudflare processes basic connection data in compliance with enterprise-grade privacy safeguards.
      </p>

      <h2>3. Cookies and Web Beacons</h2>
      <p>
        EdgeBlog uses cookies strictly for essential functionality:
      </p>
      <ul>
        <li><strong>Admin Session Cookie:</strong> Used solely to authenticate authorized administrators accessing the <code>/admin</code> publishing dashboard.</li>
        <li><strong>Third-Party Vendors:</strong> Third-party vendors, including Google, may use cookies to serve ads or analyze traffic based on a user's prior visits to our website or other websites. You may choose to disable cookies through your individual browser settings.</li>
      </ul>

      <h2>4. GDPR Data Protection Rights (European Union)</h2>
      <p>
        Under the General Data Protection Regulation (GDPR), every user is entitled to the following:
      </p>
      <ul>
        <li><strong>The right to access:</strong> You have the right to request copies of your personal data.</li>
        <li><strong>The right to rectification:</strong> You have the right to request correction of any information you believe is inaccurate.</li>
        <li><strong>The right to erasure:</strong> You have the right to request that we erase your personal data under certain conditions.</li>
        <li><strong>The right to restrict processing:</strong> You have the right to request restriction of the processing of your personal data.</li>
      </ul>

      <h2>5. CCPA Privacy Rights (Do Not Sell My Personal Information)</h2>
      <p>
        Under the California Consumer Privacy Act (CCPA), California consumers have the right to request disclosure of categories and specific pieces of personal data collected, as well as deletion of collected personal data. <strong>We do not sell personal information to third parties.</strong>
      </p>

      <h2>6. Children's Online Privacy Protection (COPPA)</h2>
      <p>
        EdgeBlog does not knowingly collect any Personal Identifiable Information from children under the age of 13. If you believe your child provided this kind of information on our website, we strongly encourage you to contact us immediately, and we will promptly remove such information from our records.
      </p>

      <h2>7. Contact Us Regarding Your Privacy</h2>
      <p>
        If you have any questions or require more information about our Privacy Policy, please do not hesitate to contact us through our <a href="/contact">Contact Page</a>.
      </p>
    </div>
  </div>
</BaseLayout>
