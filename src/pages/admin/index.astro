---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllPosts } from '../../lib/kv';

// Get all posts including drafts
const posts = await getAllPosts(false);
const totalPosts = posts.length;
const publishedPosts = posts.filter(p => p.status === 'published').length;
const draftPosts = posts.filter(p => p.status === 'draft').length;
---

<AdminLayout title="Dashboard Overview">
  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Total Articles</div>
        <div class="text-3xl font-extrabold text-slate-900 mt-1">{totalPosts}</div>
      </div>
      <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
        📚
      </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Published</div>
        <div class="text-3xl font-extrabold text-emerald-600 mt-1">{publishedPosts}</div>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
        ✓
      </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Drafts</div>
        <div class="text-3xl font-extrabold text-amber-600 mt-1">{draftPosts}</div>
      </div>
      <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
        📝
      </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
      <div>
        <div class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Edge Database</div>
        <div class="text-sm font-bold text-slate-800 mt-1 flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Cloudflare KV
        </div>
      </div>
      <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl">
        ⚡
      </div>
    </div>
  </div>

  <!-- Recent Posts Section -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-200 flex items-center justify-between">
      <div>
        <h2 class="text-base font-bold text-slate-900">Recent Articles in KV</h2>
        <p class="text-xs text-slate-500 mt-0.5">Manage, edit, or check SEO configuration of your posts</p>
      </div>
      <a
        href="/admin/posts/new"
        class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-sm transition-all flex items-center gap-1.5"
      >
        <span>+</span> Write Post
      </a>
    </div>

    {posts.length === 0 ? (
      <div class="p-12 text-center text-slate-500">
        <p class="text-sm">No posts found in KV storage yet.</p>
        <a href="/admin/posts/new" class="mt-3 inline-block text-xs font-semibold text-blue-600 hover:underline">
          Publish your first article →
        </a>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase font-semibold text-slate-500 tracking-wider">
            <tr>
              <th scope="col" class="px-6 py-3.5">Title & Slug</th>
              <th scope="col" class="px-6 py-3.5">Category</th>
              <th scope="col" class="px-6 py-3.5">Status</th>
              <th scope="col" class="px-6 py-3.5">Published Date</th>
              <th scope="col" class="px-6 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {posts.slice(0, 10).map((post) => (
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="px-6 py-4">
                  <div class="font-bold text-slate-900 line-clamp-1">{post.title}</div>
                  <div class="text-xs text-slate-400 font-mono mt-0.5">/{post.slug}</div>
                </td>
                <td class="px-6 py-4">
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
                    {post.category || 'General'}
                  </span>
                </td>
                <td class="px-6 py-4">
                  {post.status === 'published' ? (
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                      Published
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                      Draft
                    </span>
                  )}
                </td>
                <td class="px-6 py-4 text-xs text-slate-500">
                  {new Date(post.published_at).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </td>
                <td class="px-6 py-4 text-right space-x-2">
                  <a
                    href={`/post/${post.slug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-semibold text-slate-600 hover:text-blue-600 hover:underline"
                  >
                    View
                  </a>
                  <span class="text-slate-300">|</span>
                  <a
                    href={`/admin/posts/${post.slug}/edit`}
                    class="text-xs font-semibold text-blue-600 hover:text-blue-800 hover:underline"
                  >
                    Edit & SEO
                  </a>
                  <span class="text-slate-300">|</span>
                  <button
                    type="button"
                    data-slug={post.slug}
                    class="delete-btn text-xs font-semibold text-rose-600 hover:text-rose-800 hover:underline"
                  >
                    Delete
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const slug = (e.currentTarget as HTMLButtonElement).dataset.slug;
      if (!slug) return;

      if (!confirm(`Are you sure you want to delete post "${slug}" from Cloudflare KV?`)) {
        return;
      }

      try {
        const res = await fetch('/api/posts/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert(data.error || 'Failed to delete post.');
        }
      } catch (err) {
        alert('Network error while deleting.');
      }
    });
  });
</script>
