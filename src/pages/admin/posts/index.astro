---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAllPosts } from '../../../lib/kv';

const posts = await getAllPosts(false);
---

<AdminLayout title="All Articles">
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <!-- Header & Controls -->
    <div class="p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-slate-900">Articles Management</h2>
        <p class="text-xs text-slate-500 mt-0.5">Showing all posts stored in Cloudflare KV</p>
      </div>

      <div class="flex items-center gap-3">
        <input
          type="text"
          id="search-input"
          placeholder="Search by title or slug..."
          class="px-3.5 py-1.5 rounded-lg border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none w-56"
        />
        <a
          href="/admin/posts/new"
          class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-sm transition-all"
        >
          + New Post
        </a>
      </div>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm text-slate-600" id="posts-table">
        <thead class="bg-slate-50 border-b border-slate-200 text-xs uppercase font-semibold text-slate-500 tracking-wider">
          <tr>
            <th scope="col" class="px-6 py-3.5">Title & URL</th>
            <th scope="col" class="px-6 py-3.5">Category</th>
            <th scope="col" class="px-6 py-3.5">Status</th>
            <th scope="col" class="px-6 py-3.5">Read Time</th>
            <th scope="col" class="px-6 py-3.5">Published Date</th>
            <th scope="col" class="px-6 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200" id="posts-tbody">
          {posts.map((post) => (
            <tr class="hover:bg-slate-50/80 transition-colors post-row" data-search={`${post.title} ${post.slug} ${post.category}`}>
              <td class="px-6 py-4">
                <div class="font-bold text-slate-900 line-clamp-1">{post.title}</div>
                <div class="text-xs text-slate-400 font-mono mt-0.5">/post/{post.slug}</div>
              </td>
              <td class="px-6 py-4">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
                  {post.category || 'General'}
                </span>
              </td>
              <td class="px-6 py-4">
                {post.status === 'published' ? (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                    Published
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                    Draft
                  </span>
                )}
              </td>
              <td class="px-6 py-4 text-xs text-slate-500">
                ⏱️ {post.reading_time_minutes} min
              </td>
              <td class="px-6 py-4 text-xs text-slate-500">
                {new Date(post.published_at).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}
              </td>
              <td class="px-6 py-4 text-right space-x-2">
                <a
                  href={`/post/${post.slug}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-slate-600 hover:text-blue-600 hover:underline"
                >
                  View
                </a>
                <span class="text-slate-300">|</span>
                <a
                  href={`/admin/posts/${post.slug}/edit`}
                  class="text-xs font-semibold text-blue-600 hover:text-blue-800 hover:underline"
                >
                  Edit
                </a>
                <span class="text-slate-300">|</span>
                <button
                  type="button"
                  data-slug={post.slug}
                  class="delete-btn text-xs font-semibold text-rose-600 hover:text-rose-800 hover:underline"
                >
                  Delete
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>

<script>
  // Filter table
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const rows = document.querySelectorAll('.post-row');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      rows.forEach((row) => {
        const text = (row.getAttribute('data-search') || '').toLowerCase();
        if (text.includes(query)) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });
  }

  // Delete handler
  document.querySelectorAll('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const slug = (e.currentTarget as HTMLButtonElement).dataset.slug;
      if (!slug) return;

      if (!confirm(`Are you sure you want to delete post "${slug}" from Cloudflare KV?`)) {
        return;
      }

      try {
        const res = await fetch('/api/posts/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert(data.error || 'Failed to delete post.');
        }
      } catch (err) {
        alert('Network error while deleting.');
      }
    });
  });
</script>
