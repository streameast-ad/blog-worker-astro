---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_CONFIG } from '../lib/config';
import { generateWebPageSchema, generateBreadcrumbSchema } from '../lib/seo';

const pageTitle = `Contact Us — ${SITE_CONFIG.title}`;
const pageDescription = `Get in touch with the EdgeBlog team for editorial inquiries, technical partnerships, or edge computing support.`;

const breadcrumbs = [
  { name: 'Contact Us', url: '/contact' }
];

const webPageSchema = generateWebPageSchema('Contact Us', pageDescription, '/contact');
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={`${SITE_CONFIG.site_url}/contact`}
  schema={webPageSchema}
  breadcrumbSchema={breadcrumbSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-10 pb-6 border-b border-slate-200">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-semibold mb-3">
        <span>📬 Get in Touch</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Contact Our Editorial Team
      </h1>
      <p class="text-base sm:text-lg text-slate-600 mt-2">
        Have questions, feedback, or content suggestions? We would love to hear from you.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Contact Info Cards -->
      <div class="space-y-4">
        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
          <div class="text-blue-600 font-bold text-lg mb-1">✉️ Email</div>
          <p class="text-xs text-slate-500 mb-2">Direct editorial contact</p>
          <a href="mailto:contact@myedgeblog.workers.dev" class="text-sm font-semibold text-blue-600 hover:underline">
            contact@myedgeblog.workers.dev
          </a>
        </div>

        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
          <div class="text-blue-600 font-bold text-lg mb-1">🌐 Social</div>
          <p class="text-xs text-slate-500 mb-2">Follow our latest edge updates</p>
          <div class="flex items-center gap-3 text-sm font-semibold text-slate-700">
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600">Twitter / X</a>
            <span>•</span>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600">GitHub</a>
          </div>
        </div>

        <div class="bg-blue-50 p-5 rounded-xl border border-blue-100 text-xs text-blue-900 leading-relaxed">
          <strong>⚡ Response Time:</strong> We review all legitimate editorial inquiries and bug reports within 24–48 business hours.
        </div>
      </div>

      <!-- Contact Form -->
      <div class="md:col-span-2 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 mb-4">Send Us a Direct Message</h2>

        <form id="contact-form" class="space-y-5" onsubmit="event.preventDefault(); document.getElementById('success-message').classList.remove('hidden'); this.reset();">
          <div>
            <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
              Full Name <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. Alex Johnson"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
              Email Address <span class="text-rose-500">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="you@example.com"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all"
            />
          </div>

          <div>
            <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
              Subject
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="Question about Cloudflare Workers / SEO"
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">
              Message <span class="text-rose-500">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Write your message here..."
              class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none text-sm transition-all"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 px-6 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm shadow-md shadow-blue-500/20 transition-all"
          >
            Submit Message
          </button>
        </form>

        <div id="success-message" class="hidden mt-4 p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">
          ✓ Thank you! Your message has been sent successfully. We will get back to you shortly.
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
