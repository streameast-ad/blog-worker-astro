---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts } from '../lib/kv';
import { SITE_CONFIG } from '../lib/config';
import { generateWebSiteSchema } from '../lib/seo';

// Fetch all published posts from KV
const posts = await getAllPosts(true);

const websiteSchema = generateWebSiteSchema();
---

<BaseLayout
  title={`${SITE_CONFIG.title} — Lightning Fast Edge Blog`}
  description={SITE_CONFIG.description}
  schema={websiteSchema}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-blue-50/60 via-slate-50 to-slate-50 border-b border-slate-200/80 pt-16 pb-20 overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-semibold mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        Hosted on Cloudflare Workers & KV Storage
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Modern Edge Insights & <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">
          High-Speed Tech Articles
        </span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
        {SITE_CONFIG.description}
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4 text-sm font-medium">
        <a
          href="#articles"
          class="px-6 py-3 rounded-lg bg-blue-600 text-white hover:bg-blue-700 shadow-md shadow-blue-500/20 transition-all font-semibold"
        >
          Explore Articles ↓
        </a>
        <a
          href="/admin"
          class="px-6 py-3 rounded-lg bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 hover:border-slate-400 transition-all font-semibold"
        >
          Open Admin Panel
        </a>
      </div>
    </div>
  </section>

  <!-- Main Articles Feed Section -->
  <section id="articles" class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-slate-200 gap-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Latest Published Articles
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          Explore tutorials, guides, and architectural insights.
        </p>
      </div>

      <div class="text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1.5 rounded-full self-start sm:self-auto">
        {posts.length} {posts.length === 1 ? 'Article' : 'Articles'} Available
      </div>
    </div>

    {posts.length === 0 ? (
      <div class="text-center py-20 bg-white rounded-2xl border border-dashed border-slate-300 p-8">
        <div class="text-4xl mb-3">📝</div>
        <h3 class="text-lg font-bold text-slate-800">No posts published yet</h3>
        <p class="text-slate-500 text-sm mt-1 max-w-md mx-auto">
          Sign into the admin panel to publish your first high-speed blog post directly into Cloudflare KV.
        </p>
        <a
          href="/admin/posts/new"
          class="mt-5 inline-block px-5 py-2.5 bg-blue-600 text-white font-medium text-sm rounded-lg hover:bg-blue-700 transition-colors"
        >
          Create First Post
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}
  </section>

  <!-- SEO / Feature Highlights Banner -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 rounded-2xl p-8 sm:p-12 text-white shadow-xl">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-400">Google SEO 2026 Ready</span>
        <h2 class="text-2xl sm:text-3xl font-bold mt-2">Built for Pure Speed and Top Search Rankings</h2>
        <p class="mt-4 text-slate-300 text-sm sm:text-base leading-relaxed">
          Every page is rendered on Cloudflare Workers edge nodes across 300+ cities with automated Schema.org JSON-LD structured data, XML sitemaps, Open Graph preview tags, and strict Core Web Vitals optimization.
        </p>
        <div class="mt-6 flex flex-wrap gap-6 text-xs text-slate-300 font-medium">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> 100% Core Web Vitals
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> Schema.org JSON-LD
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> Dynamic Sitemap & RSS
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span> Cloudflare KV Edge Database
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
