---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Admin Dashboard</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col md:flex-row">
    <!-- Admin Sidebar -->
    <aside class="w-full md:w-64 bg-slate-900 text-slate-300 flex-shrink-0 flex flex-col justify-between border-r border-slate-800">
      <div>
        <!-- Sidebar Brand -->
        <div class="h-16 flex items-center justify-between px-6 border-b border-slate-800">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-blue-600 flex items-center justify-center text-white text-xs font-bold">
              ⚡
            </div>
            <span class="font-bold text-white tracking-tight">Edge Admin</span>
          </div>
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-blue-900/60 text-blue-300 border border-blue-700/50">
            KV Edge
          </span>
        </div>

        <!-- Navigation Links -->
        <nav class="p-4 space-y-1.5" aria-label="Admin Navigation">
          <a
            href="/admin"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
              pathname === '/admin' || pathname === '/admin/'
                ? 'bg-blue-600 text-white shadow-sm'
                : 'text-slate-300 hover:bg-slate-800 hover:text-white'
            }`}
          >
            <span>📊</span>
            <span>Dashboard</span>
          </a>

          <a
            href="/admin/posts"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
              pathname === '/admin/posts' || pathname === '/admin/posts/'
                ? 'bg-blue-600 text-white shadow-sm'
                : 'text-slate-300 hover:bg-slate-800 hover:text-white'
            }`}
          >
            <span>📝</span>
            <span>All Posts</span>
          </a>

          <a
            href="/admin/posts/new"
            class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
              pathname === '/admin/posts/new'
                ? 'bg-blue-600 text-white shadow-sm'
                : 'text-slate-300 hover:bg-slate-800 hover:text-white'
            }`}
          >
            <span>➕</span>
            <span>Write New Post</span>
          </a>
        </nav>
      </div>

      <!-- Bottom User & Site Links -->
      <div class="p-4 border-t border-slate-800 space-y-2">
        <a
          href="/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white transition-colors"
        >
          <span class="flex items-center gap-2">
            <span>🌐</span>
            <span>View Live Site</span>
          </span>
          <span>↗</span>
        </a>

        <a
          href="/admin/logout"
          class="flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-semibold text-rose-400 hover:bg-rose-950/40 hover:text-rose-300 transition-colors w-full"
        >
          <span>🚪</span>
          <span>Sign Out</span>
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-h-screen overflow-x-hidden">
      <!-- Top Bar -->
      <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between">
        <h1 class="text-lg font-bold text-slate-800">{title}</h1>
        <div class="flex items-center gap-3">
          <a
            href="/admin/posts/new"
            class="px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold shadow-sm transition-all"
          >
            + New Post
          </a>
        </div>
      </header>

      <main class="flex-1 p-6 md:p-8">
        <slot />
      </main>
    </div>
  </body>
</html>
